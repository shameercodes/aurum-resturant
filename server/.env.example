PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/aurum_eats

JWT_SECRET=your_super_secret_min_32_characters_long
JWT_EXPIRE=30d
OTP_EXPIRE_MINUTES=10

APP_NAME=Aurum Eats

# Email (Gmail SMTP / Nodemailer)
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# EMAIL_FROM must be the SAME address as EMAIL_USER, unless you added a "Send mail as" alias in Gmail.
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_FROM=your@gmail.com

# Development only: return OTP in API + show on verify page (never enable in production)
DEV_SHOW_OTP=true

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS (production, comma-separated)
# ALLOWED_ORIGINS=https://yoursite.com

# Admin (auto-created on first start — change immediately)
ADMIN_EMAIL=admin@aurumrestaurant.co.uk
ADMIN_PASSWORD=Aurum@Admin2025
ADMIN_NAME=Admin
